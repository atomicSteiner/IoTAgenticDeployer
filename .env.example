# Copy to .env and fill in. Only OPENAI_API_KEY has no working default.

# OpenRouter. The variable is called OPENAI_API_KEY because the client is the
# OpenAI-compatible one; the key itself is an OpenRouter key and starts sk-or-.
OPENAI_API_KEY="sk-or-..."
OPENAI_MODEL="anthropic/claude-haiku-4.5"

# Optional: a different model for the two calls a weaker one handles worst.
# Routing decides which agents run; the reply is the only text the architect reads.
#ROUTER_MODEL=""
#RESPONSE_MODEL=""

# Optional: ThingsBoard, only needed to deploy there.
#THINGSBOARD_MCP_URL="http://localhost:8000/sse"

# Optional: OpenRemote, only needed to deploy there. The client id and secret
# belong to a service user of the realm and have no default.
#OPENREMOTE_URL="http://localhost:8080"
#OPENREMOTE_AUTH_URL="http://localhost:8081/auth"
#OPENREMOTE_REALM="master"
#OPENREMOTE_CLIENT_ID=""
#OPENREMOTE_CLIENT_SECRET=""

# Optional: Langfuse tracing, one trace per turn and one session per
# conversation. Unset, nothing is traced. The keys come from the project
# settings; the base URL defaults to the EU cloud, change it to self-host.
#LANGFUSE_PUBLIC_KEY="pk-lf-..."
#LANGFUSE_SECRET_KEY="sk-lf-..."
#LANGFUSE_BASE_URL="https://cloud.langfuse.com"
